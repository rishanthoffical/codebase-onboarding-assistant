from __future__ import annotations

import os
from typing import Any, Dict, Optional

import requests


class OllamaProvider:
    """Local Ollama/Gemma provider."""

    def __init__(self) -> None:
        self.base_url = os.getenv(
            "OLLAMA_BASE_URL",
            "http://localhost:11434",
        )
        self.model = os.getenv(
            "OLLAMA_MODEL",
            "gemma4:26b",
        )

    def generate(self, question: str, context: str) -> str:
        max_context_length = 8000
        context = context[:max_context_length]

        prompt = f"""You are a Codebase Onboarding Assistant.

Answer the developer's question using ONLY the provided codebase context.

Give a short, direct answer.
Mention the exact file path when available.
Do not repeat the code.

CODEBASE CONTEXT:
{context}

DEVELOPER QUESTION:
{question}

ANSWER:"""

        response = requests.post(
            f"{self.base_url}/api/generate",
            json={
                "model": self.model,
                "prompt": prompt,
                "stream": False,
                "think": False,
                "options": {
                    "num_predict": 128,
                    "temperature": 0.2,
                },
            },
            timeout=900,
        )

        response.raise_for_status()

        data = response.json()
        result = data.get("response", "").strip()

        if not result:
            return "I could not generate an AI response."

        return result


class ClaudeProvider:
    """Anthropic Claude Messages API provider."""

    API_URL = "https://api.anthropic.com/v1/messages"

    def __init__(self) -> None:
        self.api_key = os.getenv(
            "ANTHROPIC_API_KEY",
            "",
        )

        # Keep this configurable so the model can be changed
        # without modifying source code.
        self.model = os.getenv(
            "CLAUDE_MODEL",
            "",
        )

        self.max_tokens = int(
            os.getenv(
                "CLAUDE_MAX_TOKENS",
                "512",
            )
        )

    def generate(self, question: str, context: str) -> str:
        if not self.api_key:
            raise RuntimeError(
                "ANTHROPIC_API_KEY is required when "
                "LLM_PROVIDER=claude."
            )

        if not self.model:
            raise RuntimeError(
                "CLAUDE_MODEL is required when "
                "LLM_PROVIDER=claude."
            )

        max_context_length = 8000
        context = context[:max_context_length]

        system_prompt = (
            "You are a Codebase Onboarding Assistant. "
            "Answer developer questions using only the "
            "provided codebase context. "
            "Give short, direct answers and mention exact "
            "file paths when available. "
            "Do not invent files, functions, or behavior."
        )

        user_prompt = f"""CODEBASE CONTEXT:

{context}

DEVELOPER QUESTION:

{question}
"""

        response = requests.post(
            self.API_URL,
            headers={
                "x-api-key": self.api_key,
                "anthropic-version": "2023-06-01",
                "content-type": "application/json",
            },
            json={
                "model": self.model,
                "max_tokens": self.max_tokens,
                "temperature": 0.2,
                "system": system_prompt,
                "messages": [
                    {
                        "role": "user",
                        "content": user_prompt,
                    }
                ],
            },
            timeout=900,
        )

        response.raise_for_status()

        data = response.json()

        content = data.get("content", [])

        text_parts = []

        for block in content:
            if block.get("type") == "text":
                text_parts.append(
                    block.get("text", "")
                )

        result = "".join(text_parts).strip()

        if not result:
            return "I could not generate an AI response."

        return result


class LLMService:
    """
    Provider-independent LLM service.

    Existing code can continue using:

        LLMService().generate(question, context)

    Provider selection:

        LLM_PROVIDER=ollama
        LLM_PROVIDER=claude
    """

    def __init__(
        self,
        provider: Optional[str] = None,
    ) -> None:

        provider_name = (
            provider
            or os.getenv(
                "LLM_PROVIDER",
                "ollama",
            )
        ).strip().lower()

        if provider_name == "ollama":
            self.provider = OllamaProvider()

        elif provider_name == "claude":
            self.provider = ClaudeProvider()

        else:
            raise ValueError(
                f"Unsupported LLM provider: "
                f"{provider_name}. "
                f"Use 'ollama' or 'claude'."
            )

        self.provider_name = provider_name

    def generate(
        self,
        question: str,
        context: str,
    ) -> str:

        return self.provider.generate(
            question=question,
            context=context,
        )