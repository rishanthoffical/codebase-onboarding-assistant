def diff_index(base_commit, head_commit):
    import subprocess

    # Get the list of changed files between the two commits
    changed_files = subprocess.check_output(
        ['git', 'diff', '--name-only', base_commit, head_commit],
        stderr=subprocess.STDOUT
    ).decode('utf-8').strip().split('\n')

    # Filter out empty strings
    changed_files = [f for f in changed_files if f]

    return changed_files

def get_file_diff(file_path, base_commit, head_commit):
    import subprocess

    # Get the diff for a specific file between the two commits
    diff_output = subprocess.check_output(
        ['git', 'diff', base_commit, head_commit, '--', file_path],
        stderr=subprocess.STDOUT
    ).decode('utf-8')

    return diff_output

def diff_index_with_details(base_commit, head_commit):
    changed_files = diff_index(base_commit, head_commit)
    file_diffs = {}

    for file in changed_files:
        file_diffs[file] = get_file_diff(file, base_commit, head_commit)

    return file_diffs