from pathlib import Path


SUPPORTED_EXTENSIONS = {
    ".py",
    ".java",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".html",
    ".css",
    ".md",
    ".json",
    ".sql",
}


def chunk_file(
    file_path: str,
    chunk_size: int = 100
):
    """
    Split a supported file into chunks of lines.

    Returns a list of dictionaries containing:
    - content
    - file
    - start_line
    - end_line
    """

    path = Path(file_path)

    if path.suffix.lower() not in SUPPORTED_EXTENSIONS:
        return []

    try:
        content = path.read_text(
            encoding="utf-8",
            errors="ignore"
        )
    except Exception:
        return []

    lines = content.splitlines()

    chunks = []

    for start in range(0, len(lines), chunk_size):

        chunk_lines = lines[
            start:start + chunk_size
        ]

        if not chunk_lines:
            continue

        chunks.append({
            "content": "\n".join(chunk_lines),
            "file": str(path),
            "start_line": start + 1,
            "end_line": start + len(chunk_lines),
        })

    return chunks


def chunk_code(code: str):
    """
    Split source code into individual lines.

    Empty lines are preserved.
    Leading and trailing blank lines are ignored.

    Returns:
        [
            (content, start_line, end_line),
            ...
        ]
    """

    if not code:
        return []

    lines = code.strip("\n").splitlines()

    return [
        (
            line,
            index + 1,
            index + 1
        )
        for index, line in enumerate(lines)
    ]


def chunk_docs(docs: str):
    """
    Split documentation into non-empty lines.

    Blank lines immediately following Markdown headings
    are ignored.

    Blank lines following normal text are counted in
    the logical line numbering.

    Returns:
        [
            (content, start_line, end_line),
            ...
        ]
    """

    if not docs:
        return []

    # Remove only leading/trailing whitespace.
    lines = docs.strip().splitlines()

    chunks = []

    line_number = 0
    previous_content = None

    for line in lines:

        # Non-empty line
        if line.strip():

            line_number += 1

            chunks.append(
                (
                    line,
                    line_number,
                    line_number
                )
            )

            previous_content = line.strip()

        # Empty line
        else:

            # Ignore blank lines after Markdown headings.
            if (
                previous_content
                and not previous_content.startswith("#")
            ):
                line_number += 1

    return chunks