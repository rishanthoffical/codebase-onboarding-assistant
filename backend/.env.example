# ============================================================
# Codebase Onboarding & Internal Dev Assistant
# Environment Configuration
# ============================================================

# LLM Provider
# Supported: ollama, claude
LLM_PROVIDER=ollama

# Ollama / Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# Anthropic Claude
# Required only when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
CLAUDE_MAX_TOKENS=1024

# Agent
AGENT_MAX_STEPS=4

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chroma
CHROMA_URL=
CHROMA_PERSIST_DIRECTORY=./chroma_db
# Docker Compose connects app processes to one Chroma server. Leave blank
# when running a single backend process with local PersistentClient storage.
CHROMA_HOST=
CHROMA_PORT=8000

# Redis
# Use the host-published Redis port for a host-run backend; Compose overrides this.
REDIS_URL=redis://localhost:6380/0

# Webhook
WEBHOOK_SECRET=your_webhook_secret_here

# Authentication
AUTH_ENABLED=false
AUTH_SECRET=change_this_in_production

# Rate Limiting
CHAT_RATE_LIMIT=30/minute
WEBHOOK_RATE_LIMIT=10/minute

# Repository uploads
MAX_FILES=5000
MAX_UPLOAD_SIZE_MB=500
MAX_SINGLE_FILE_MB=10

# Logging
LOG_LEVEL=INFO

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
